+/* Repo: separa os modelos/*.sql dos ficheiros do bot e arranca com o .sql do modelo guardado (sem tocar na funcao minificada) */
+(function(){
+ var orig=correrBotComDados;
+ correrBotComDados=async function(e){
+  try{
+   var A=e&&e.arquivos;
+   if(A&&!window.lumeRepo&&Object.keys(A).some(function(n){return /^modelos\/.+\.sql$/.test(n)})){
+    var sqls={lume:e.sql},limpo={};
+    Object.keys(A).forEach(function(n){var m=n.match(/^modelos\/(.+)\.sql$/);if(m)sqls[m[1]]=A[n];else limpo[n]=A[n]});
+    window.lumeRepo={arquivos:limpo,sqls:sqls};
+    e=Object.assign({},e,{sql:sqls[modeloAtual()]||sqls.lume,arquivos:limpo});
+   }
+  }catch(_){}
+  return orig.call(this,e);
+ };
+})();
+async function trocarModelo(id){
+ var m=MODELOS.filter(function(x){return x.id===id})[0],antes=modeloAtual();
  fecharFolhaModelos();
- if(!m||id===modeloAtual())return;
+ if(!m||id===antes)return;
+ var R=window.lumeRepo;
+ if(!R||!R.sqls||!R.sqls[id]){mostrarToast("Este modelo ainda não está disponível. Tenta de novo daqui a pouco.");return}
  try{localStorage.setItem("lume_modelo",id)}catch(e){}
  aplicarModelo();
- mostrarToast(m.nome+" selecionado");
+ btnEnviar.disabled=true;
+ try{
+  await correrBotComDados({nome:"Lume",sql:R.sqls[id],arquivos:Object.assign({},R.arquivos)});
+  mostrarToast(m.nome+" ativo");
+ }catch(e){
+  try{localStorage.setItem("lume_modelo",antes)}catch(_){}
+  aplicarModelo();
+  mostrarToast("Não foi possível trocar de modelo");
+  try{await correrBotComDados({nome:"Lume",sql:R.sqls[antes]||R.sqls.lume,arquivos:Object.assign({},R.arquivos)})}catch(_){}
+ }finally{btnEnviar.disabled=false}
 }
