diff --git a/LUME/bot/modelos/codigo.sql b/LUME/bot/modelos/codigo.sql
new file mode 100644
index 0000000..3c47e3c
--- /dev/null
+++ b/LUME/bot/modelos/codigo.sql
@@ -0,0 +1,25 @@
+-- Lume Codigo: gera e explica codigo a partir de frases.
+-- O gerador de codigo (gerar_codigo.txt) corre antes, pelo despachante; aqui ficam as paginas e a loja.
+CREATE BOT "Lume"
+
+CREATE TABLE Context() PREVENT DEFAULT
+
+ON MESSAGE {
+    INSERT INTO Context()
+
+    WHEN CONTAINS KEYWORDS(palavras_loja.txt) {
+        WAITING("A montar a loja")
+        REPLY (templates.txt, 1)
+    }
+
+    OTHERWISE {
+        THINK(aprendido.txt) WAITING("A pensar...", 3) OR
+        REPLY "Estou no modo Lume Código: descreve o que queres em frases (por exemplo, «cria uma função que soma dois números») e eu gero e explico o código. Para outros assuntos, muda de modelo."
+    }
+
+    UPDATE Context
+        SET reply = lastMsg
+        WHERE id = LAST_INSERT_ID()
+}
+
+RUN BOT
diff --git a/LUME/bot/modelos/desenho.sql b/LUME/bot/modelos/desenho.sql
new file mode 100644
index 0000000..3f130e6
--- /dev/null
+++ b/LUME/bot/modelos/desenho.sql
@@ -0,0 +1,33 @@
+-- Lume Desenho: desenhos em SVG e composicoes.
+CREATE BOT "Lume"
+
+CREATE TABLE Context() PREVENT DEFAULT
+
+ON MESSAGE {
+    INSERT INTO Context()
+
+    WHEN CONTAINS KEYWORDS(pedidos_desenhos_compostos.txt) {
+        WAITING("A juntar os desenhos num só SVG...", 2)
+        REPLY (desenhos_compostos.txt, 1)
+    }
+
+    WHEN CONTAINS "svg" {
+        WAITING("A desenhar...")
+        REPLY (libdesenho.txt, 1)
+    }
+
+    WHEN CONTAINS KEYWORDS(palavras_desenho.txt) {
+        WAITING("A desenhar", 2)
+        REPLY (desenhos.txt, 1)
+    }
+
+    OTHERWISE {
+        REPLY "Estou no modo Lume Desenho: pede uma coisa de cada vez, por exemplo «desenha uma casa» ou «desenha uma casa e duas árvores». Para outros assuntos, muda de modelo."
+    }
+
+    UPDATE Context
+        SET reply = lastMsg
+        WHERE id = LAST_INSERT_ID()
+}
+
+RUN BOT
diff --git a/LUME/bot/modelos/mat.sql b/LUME/bot/modelos/mat.sql
new file mode 100644
index 0000000..a201a36
--- /dev/null
+++ b/LUME/bot/modelos/mat.sql
@@ -0,0 +1,25 @@
+-- Lume Mat: contas, equacoes, graficos e passos em KaTeX.
+-- Sem pesquisa na web; o que nao for matematica cai na resposta de reserva.
+CREATE BOT "Lume"
+
+CREATE TABLE Context() PREVENT DEFAULT
+
+ON MESSAGE {
+    INSERT INTO Context()
+
+    WHEN CONTAINS KEYWORDS (calculo.txt) {
+        WAITING("A executar o cálculo...")
+        REPLY (rescalculo.txt, 1)
+    }
+
+    OTHERWISE {
+        THINK(aprendido.txt) WAITING("A pensar...", 3) OR
+        REPLY "Estou no modo Lume Mat: trato de contas, equações, gráficos e passos. Para outros assuntos, muda de modelo no botão ao lado do campo de escrita."
+    }
+
+    UPDATE Context
+        SET reply = lastMsg
+        WHERE id = LAST_INSERT_ID()
+}
+
+RUN BOT
diff --git a/LUME/bot/modelos/rapido.sql b/LUME/bot/modelos/rapido.sql
new file mode 100644
index 0000000..be6495f
--- /dev/null
+++ b/LUME/bot/modelos/rapido.sql
@@ -0,0 +1,24 @@
+-- Lume Rapido: respostas curtas, sem pesquisa na web e sem pausas de espera.
+-- (Sem CONNECT SEARCH WIKI e sem WAITING.)
+CREATE BOT "Lume"
+
+CREATE TABLE Context() PREVENT DEFAULT
+
+ON MESSAGE {
+    INSERT INTO Context()
+
+    WHEN CONTAINS KEYWORDS (calculo.txt) {
+        REPLY (rescalculo.txt, 1)
+    }
+
+    OTHERWISE {
+        THINK(aprendido.txt) OR
+        REPLY (respostas.txt, 7)
+    }
+
+    UPDATE Context
+        SET reply = lastMsg
+        WHERE id = LAST_INSERT_ID()
+}
+
+RUN BOT
