+function svgModelo(m){return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'+m.ic+'</svg>'}
+function modeloAtual(){var id="lume";try{id=localStorage.getItem("lume_modelo")||"lume"}catch(e){}return MODELOS.some(function(m){return m.id===id})?id:"lume"}
+window.lumeModeloAtual=modeloAtual;
+function aplicarModelo(){
+ var id=modeloAtual(),m=MODELOS.filter(function(x){return x.id===id})[0],b=document.getElementById("btn-modelo");
+ document.documentElement.dataset.modelo=id;
+ if(b){b.querySelector(".bm-ic").innerHTML=svgModelo(m);b.querySelector(".bm-nome").textContent=m.nome;b.setAttribute("aria-label","Modelo: "+m.nome+". Tocar para escolher")}
+}
 /* ===== Botao "Pensar": liga/desliga o painel de Atividade e as pausas entre etapas ===== */
 function pensarLigado(){try{return localStorage.getItem("lume_pensar")!=="0"}catch(e){return true}}
 function aplicarPensar(){var on=pensarLigado();document.documentElement.classList.toggle("sem-pensar",!on);var b=document.getElementById("btn-pensar");if(b)b.setAttribute("aria-pressed",String(on))}
 function alternarPensar(){var on=!pensarLigado();try{localStorage.setItem("lume_pensar",on?"1":"0")}catch(e){}aplicarPensar();mostrarToast(on?"Pensar ligado":"Pensar desligado: respostas mais rápidas")}
-aplicarPensar();
+aplicarPensar();aplicarModelo();
