From fc6148bdc2cbbdc69dd93bd92a9fbe3aa8b341d1 Mon Sep 17 00:00:00 2001
From: adilson889 <adilson889@users.noreply.github.com>
Date: Tue, 24 Nov 2026 22:44:43 +0100
Subject: [PATCH] Chip do modelo encolhe e Pensar fica so com icone em ecras
 estreitos (enviar nunca sai da caixa)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013mpj8CHR2KQ5eHquWJURHh
---
 index.html  | 4 ++++
 mobile.html | 4 ++++
 2 files changed, 8 insertions(+)

diff --git a/index.html b/index.html
index 09749ea..e714176 100644
--- a/index.html
+++ b/index.html
@@ -777,6 +777,10 @@ button,a,[role=button],select,summary{touch-action:manipulation}
 
 #input-area .pv-pill:not(.expandido) .pv-linha-botoes>button:first-child{display:none!important}
 #input-area .pv-pill.expandido .pv-linha-botoes>button:first-child{display:flex!important}
+/* Modelo: o chip encolhe e, em ecras estreitos, o Pensar fica so com o icone, para o microfone e o enviar nunca sairem da caixa */
+#input-area .pv-linha-botoes>#btn-modelo{flex:0 1 auto;min-width:76px;max-width:190px}
+@media(max-width:430px){#input-area .pv-linha-botoes{gap:3px}#input-area .pv-linha-botoes>#btn-pensar{font-size:0;gap:0;padding:0;width:44px;justify-content:center}#input-area .pv-linha-botoes>#btn-modelo{gap:4px;padding:0 6px 0 10px}#input-area .pv-linha-botoes>#btn-modelo .bm-seta{width:16px;height:16px}}
+@media(max-width:340px){#input-area .pv-linha-botoes>#btn-modelo{min-width:64px;padding:0 8px}#input-area .pv-linha-botoes>#btn-modelo .bm-seta{display:none}}
 </style>
 </head>
 <body>
diff --git a/mobile.html b/mobile.html
index b21986c..86f24a6 100644
--- a/mobile.html
+++ b/mobile.html
@@ -764,6 +764,10 @@ input,textarea,[contenteditable="true"],
 
 #input-area .pv-pill:not(.expandido) .pv-linha-botoes>button:first-child{display:none!important}
 #input-area .pv-pill.expandido .pv-linha-botoes>button:first-child{display:flex!important}
+/* Modelo: o chip encolhe e, em ecras estreitos, o Pensar fica so com o icone, para o microfone e o enviar nunca sairem da caixa */
+#input-area .pv-linha-botoes>#btn-modelo{flex:0 1 auto;min-width:76px;max-width:190px}
+@media(max-width:430px){#input-area .pv-linha-botoes{gap:3px}#input-area .pv-linha-botoes>#btn-pensar{font-size:0;gap:0;padding:0;width:44px;justify-content:center}#input-area .pv-linha-botoes>#btn-modelo{gap:4px;padding:0 6px 0 10px}#input-area .pv-linha-botoes>#btn-modelo .bm-seta{width:16px;height:16px}}
+@media(max-width:340px){#input-area .pv-linha-botoes>#btn-modelo{min-width:64px;padding:0 8px}#input-area .pv-linha-botoes>#btn-modelo .bm-seta{display:none}}
 </style>
 </head>
 <body>
