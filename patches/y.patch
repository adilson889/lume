+#folha-modelos.aberta{transform:none}
+#folha-modelos .fm-pega{width:44px;height:4px;border-radius:2px;background:var(--border);margin:0 auto 18px}
+#folha-modelos .fm-titulo{font-size:24px;font-weight:700;line-height:1.2}
+#folha-modelos .fm-sub{font-size:15px;color:var(--muted);margin:6px 0 12px;padding-bottom:12px;border-bottom:1px solid var(--border)}
+#folha-modelos .fm-item{display:flex;align-items:center;gap:16px;width:100%;box-sizing:border-box;padding:10px 8px;border:0;border-bottom:1px solid var(--border);border-radius:0;background:transparent;color:inherit;text-align:left;font:inherit;cursor:pointer}
