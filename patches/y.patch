@@ -419,6 +419,20 @@ body::before{content:"";position:fixed;top:0;left:0;right:0;height:64px;backgrou
 #input-area .pv-linha-botoes>#btn-modelo .bm-nome{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}
