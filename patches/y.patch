 #sugestoes.so-chips #sug-avatar,#sugestoes.so-chips #sug-titulo,#sugestoes.so-chips #sug-texto{display:none}
@@ -1282,6 +1296,34 @@ function aplicarModelo(){
  document.documentElement.dataset.modelo=id;
  if(b){b.querySelector(".bm-ic").innerHTML=svgModelo(m);b.querySelector(".bm-nome").textContent=m.nome;b.setAttribute("aria-label","Modelo: "+m.nome+". Tocar para escolher")}
 }
+function fecharFolhaModelos(){
+ var f=document.getElementById("folha-modelos"),g=document.getElementById("folha-modelos-fundo");
+ if(f)f.classList.remove("aberta");if(g)g.classList.remove("aberta");
+ setTimeout(function(){var a=document.getElementById("folha-modelos"),b=document.getElementById("folha-modelos-fundo");if(a&&!a.classList.contains("aberta")){a.remove();if(b)b.remove()}},300);
+}
+function abrirFolhaModelos(){
+ if(document.getElementById("folha-modelos"))return;
+ var atual=modeloAtual(),g=document.createElement("div");g.id="folha-modelos-fundo";g.addEventListener("click",fecharFolhaModelos);
+ var f=document.createElement("div");f.id="folha-modelos";f.setAttribute("role","dialog");f.setAttribute("aria-label","Modelos");
+ f.innerHTML='<div class="fm-pega"></div><div class="fm-titulo">Modelos</div><div class="fm-sub">Cada modelo carrega o seu próprio .sql.</div>';
+ MODELOS.forEach(function(m){
+  var b=document.createElement("button");b.type="button";b.className="fm-item"+(m.id===atual?" sel":"");b.setAttribute("aria-pressed",String(m.id===atual));
+  b.innerHTML='<span class="fm-ic">'+svgModelo(m)+'</span><span><span class="fm-nome"></span><span class="fm-desc"></span></span>';
+  b.querySelector(".fm-nome").textContent=m.nome;b.querySelector(".fm-desc").textContent=m.desc;
+  b.addEventListener("click",function(){trocarModelo(m.id)});f.appendChild(b);
+ });
+ document.body.appendChild(g);document.body.appendChild(f);
+ requestAnimationFrame(function(){requestAnimationFrame(function(){g.classList.add("aberta");f.classList.add("aberta")})});
+}
+document.addEventListener("keydown",function(e){if(e.key==="Escape"&&document.getElementById("folha-modelos"))fecharFolhaModelos()});
+function trocarModelo(id){
+ var m=MODELOS.filter(function(x){return x.id===id})[0];
+ fecharFolhaModelos();
+ if(!m||id===modeloAtual())return;
+ try{localStorage.setItem("lume_modelo",id)}catch(e){}
+ aplicarModelo();
+ mostrarToast(m.nome+" selecionado");
+}
 /* ===== Botao "Pensar": liga/desliga o painel de Atividade e as pausas entre etapas ===== */
 function pensarLigado(){try{return localStorage.getItem("lume_pensar")!=="0"}catch(e){return true}}
 function aplicarPensar(){var on=pensarLigado();document.documentElement.classList.toggle("sem-pensar",!on);var b=document.getElementById("btn-pensar");if(b)b.setAttribute("aria-pressed",String(on))}
