+#folha-modelos .fm-ic{display:flex;align-items:center;justify-content:center;flex:none;width:44px;height:44px;border-radius:14px;background:var(--bg3);color:var(--r)}
+#folha-modelos .fm-ic svg{width:24px;height:24px}
+#folha-modelos .fm-nome{display:block;font-size:18px;font-weight:600;line-height:1.25}
+#folha-modelos .fm-desc{display:block;font-size:15px;line-height:1.35;color:var(--muted)}
 /* saudacao sem icones e sugestoes por baixo */
