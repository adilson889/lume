From 4f74aecb72b98546b19f119ba510d8dd052fa398 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 23 Nov 2026 06:34:13 +0100
Subject: [PATCH] Fixa o interpretador XLang a um commit do HTMLx-lang

A CDN servia um xlang-modules.json antigo em @main e os modulos novos
(grafico, tabela, codigo) davam module not found.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WSxEuMqWJctVEWGHazoT3g
---
 index.html  | 4 +++-
 mobile.html | 4 +++-
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/index.html b/index.html
index b5d80c3..5acca7c 100644
--- a/index.html
+++ b/index.html
@@ -947,11 +947,13 @@ function prepararXlangSql(src){
  return out+src.slice(ultimo);
 }
 /* HTMLx-lang: corre os blocos <script type="text/xlang"> devolvidos pelo motor dentro do balão */
+/* Commit do HTMLx-lang usado pelo chat. Fixo para a CDN nao servir um xlang-modules.json antigo; mudar quando houver modulos novos. */
+const XLANG_COMMIT="fa5dbc4a93c92ecf7c56591b357a12560414884a";
 let _xlangPromessa=null;
 function carregarXlang(){
  if(window.XLangInterpreter)return Promise.resolve();
  if(!_xlangPromessa){
-  _xlangPromessa=carregarScript("https://cdn.jsdelivr.net/gh/adilson889/HTMLx-lang@main/xlang-interpreter.js")
+  _xlangPromessa=carregarScript("https://cdn.jsdelivr.net/gh/adilson889/HTMLx-lang@"+XLANG_COMMIT+"/xlang-interpreter.js")
    .catch(function(){return carregarScript("xlang-interpreter.js")})
    .then(function(){if(!window.XLangInterpreter)throw new Error("interpretador indisponível")});
   _xlangPromessa.catch(function(){_xlangPromessa=null});
diff --git a/mobile.html b/mobile.html
index 700258d..f5e09e1 100644
--- a/mobile.html
+++ b/mobile.html
@@ -943,11 +943,13 @@ function prepararXlangSql(src){
  return out+src.slice(ultimo);
 }
 /* HTMLx-lang: corre os blocos <script type="text/xlang"> devolvidos pelo motor dentro do balão */
+/* Commit do HTMLx-lang usado pelo chat. Fixo para a CDN nao servir um xlang-modules.json antigo; mudar quando houver modulos novos. */
+const XLANG_COMMIT="fa5dbc4a93c92ecf7c56591b357a12560414884a";
 let _xlangPromessa=null;
 function carregarXlang(){
  if(window.XLangInterpreter)return Promise.resolve();
  if(!_xlangPromessa){
-  _xlangPromessa=carregarScript("https://cdn.jsdelivr.net/gh/adilson889/HTMLx-lang@main/xlang-interpreter.js")
+  _xlangPromessa=carregarScript("https://cdn.jsdelivr.net/gh/adilson889/HTMLx-lang@"+XLANG_COMMIT+"/xlang-interpreter.js")
    .catch(function(){return carregarScript("xlang-interpreter.js")})
    .then(function(){if(!window.XLangInterpreter)throw new Error("interpretador indisponível")});
   _xlangPromessa.catch(function(){_xlangPromessa=null});
