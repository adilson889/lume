{
  "id": "./",
  "name": "Lume",
  "short_name": "Lume",
  "description": "Lume: assistente conversacional em português que conversa, calcula, desenha e ajuda com código, mesmo com ligação fraca.",
  "lang": "pt",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#EDEEE8",
  "theme_color": "#EDEEE8",
  "categories": ["productivity", "education", "utilities"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "LUME/assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "LUME/assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "LUME/assets/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "LUME/assets/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Nova conversa",
      "short_name": "Nova",
      "description": "Começar uma conversa nova com o Lume",
      "url": "./?acao=nova",
      "icons": [{ "src": "LUME/assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Ensinar o Lume",
      "short_name": "Ensinar",
      "description": "Ensinar uma resposta nova ao Lume",
      "url": "./?acao=ensinar",
      "icons": [{ "src": "LUME/assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "titulo", "text": "texto", "url": "link" }
  }
}
